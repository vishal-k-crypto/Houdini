# ========================================
# Houdini Agent Environment Configuration
# ========================================

# -------------------------------------------------
# API Keys (Required for cloud features)
# -------------------------------------------------
# Get your Gemini API key from: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# -------------------------------------------------
# Model Configuration
# -------------------------------------------------
# Path to local LLM model (GGUF format)
# Recommended: qwen2.5-7b-instruct-q5_k_m.gguf
MODEL_PATH=./models/qwen2.5-7b-instruct-q5_k_m.gguf

# Default Ollama model for planning
OLLAMA_MODEL=qwen3-coder:480b-cloud

# -------------------------------------------------
# Cloud Endpoints (Optional)
# -------------------------------------------------
# Ollama cloud endpoint (if using cloud Ollama)
# OLLAMA_CLOUD_ENDPOINT=https://cloud.ollama.ai

# -------------------------------------------------
# Logging & Debug
# -------------------------------------------------
LOG_LEVEL=INFO
# DEBUG=true

# -------------------------------------------------
# UI Configuration
# -------------------------------------------------
# Enable/disable thinking window
ENABLE_THINKING_WINDOW=false

# -------------------------------------------------
# Local Vision Models (Optional)
# -------------------------------------------------
# Path to OmniParser model
# OMNIPARSER_MODEL_PATH=./models/omniparser

# UI-TARS model (MLX format for Apple Silicon)
# UITARS_MODEL=mlx-community/UI-TARS-7B-SFT-4bit
