# =====================================================================
# Houdini Agent — Environment Configuration
# =====================================================================
# Copy this file to .env and adjust values for your setup.
# All values below are optional — defaults are shown (commented out).
# Environment variables always take priority over .env values.
#
# Configuration is managed by config/settings.py (HoudiniSettings).
# =====================================================================

# ----- API Keys -----
# Get your API keys from the provider console and uncomment/set below.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here
# DEEPSEEK_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-...
# XAI_API_KEY=xai-...                      # Also accepted: GROK_API_KEY

# ----- Models -----
# OLLAMA_DEFAULT_MODEL=qwen3-coder:480b-cloud
# OLLAMA_ENDPOINT=                           # Leave empty for local Ollama
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# SUPERVISOR_MODEL=qwen2.5-coder:32b
# LOCAL_SUPERVISOR_MODEL_PATH=./models/qwen2.5-7b-instruct-q5_k_m.gguf
# TINYCLICK_MODEL_ID=Krystianz/TinyClick
# GEMINI_MODEL=gemini-2.0-flash-exp
# OPENAI_MODEL=gpt-4o
# ANTHROPIC_MODEL=claude-3-5-sonnet-20240620
# DEEPSEEK_MODEL=deepseek-chat
# OPENROUTER_MODEL=openrouter/anthropic/claude-3.5-sonnet
# XAI_MODEL=grok-2-latest

# ----- LLM Parameters -----
# OLLAMA_DEFAULT_TEMPERATURE=0.7
# OLLAMA_MAX_TOKENS=4096
# OLLAMA_RETRY_COUNT=3
# PLANNER_TEMPERATURE=0.3
# SUPERVISOR_ANALYSIS_TEMPERATURE=0.3
# VALIDATOR_TEMPERATURE=0.1
# VALIDATOR_MAX_TOKENS=128

# ----- Confidence Thresholds -----
# COMPLETION_CONFIDENCE_THRESHOLD=0.75       # Min confidence for task completion
# TASK_VERIFIER_CONFIDENCE_THRESHOLD=0.65    # Min confidence in TaskVerifier aggregate
# SUPERVISOR_CONFIDENCE_THRESHOLD=0.7        # Supervisor decision threshold
# PATTERN_SIMILARITY_THRESHOLD=0.7           # Min similarity for cached pattern reuse
# HIGH_CONFIDENCE_PATTERN_THRESHOLD=0.85     # Skip LLM if pattern confidence >= this
# ZERO_ELEMENT_SCREENSHOT_CAP=0.80           # Max confidence for zero-element with screenshot
# ZERO_ELEMENT_NO_SCREENSHOT_CAP=0.65        # Max confidence for zero-element without screenshot

# ----- Execution Limits -----
# MAX_ITERATIONS=100                         # Max iterations in adaptive coordinator
# MAX_STEP_ATTEMPTS=5                        # Max retries per stuck macro step
# MAX_EVOLUTION_ATTEMPTS=3                   # Max supervisor evolution attempts
# VISION_ACTION_MAX_ATTEMPTS=3               # Max vision action retries
# MAX_RETRIES=5                              # General max retries

# ----- Timeouts (seconds) -----
# OLLAMA_GENERATE_TIMEOUT=60
# GEMINI_CLI_TIMEOUT=30
# SCREEN_CAPTURE_TIMEOUT=5
# STUCK_DETECTION_THRESHOLD=15.0             # Seconds before step considered stuck
# STUCK_TIMEOUT=10.0                         # Recovery handler stuck timeout
# UI_SETTLE_WAIT=0.5                         # Wait for UI to settle after actions
# BROWSER_LOAD_WAIT=8                        # Wait for browser page load
# ACTION_DELAY=0.05                          # Delay between micro actions

# ----- File Paths -----
# DATA_DIR=./data                            # Base data directory
# EXECUTOR_HISTORY_FILE=./data/executor_history.json
# REPLAY_SESSIONS_DIR=./data/replay_sessions
# SCREENSHOTS_DIR=./data/screenshots
# TRAINING_SESSIONS_DIR=./data/training_sessions
# TINYCLICK_VENV_PATH=.tinyclick-venv

# ----- Screen -----
# SCREEN_WIDTH=1920                          # Fallback screen width
# SCREEN_HEIGHT=1080                         # Fallback screen height

# ----- Infrastructure -----
# REDIS_URL=redis://localhost:6379           # Redis URL for multi-worker mode
# WORKER_ID=worker-default                   # Worker ID for distributed execution

# ----- Logging & Debug -----
LOG_LEVEL=INFO
# DEBUG=true
# ENABLE_THINKING_WINDOW=false
